{
  "$defs": {
    "MigrationRecord": {
      "additionalProperties": false,
      "properties": {
        "compatibility_phase": {
          "enum": [
            "EXPAND",
            "MIGRATE",
            "VERIFY",
            "CONTRACT"
          ],
          "title": "Compatibility Phase",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "migration_id": {
          "title": "Migration Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "postgresql_down_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postgresql Down Path"
        },
        "postgresql_down_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postgresql Down Sha256"
        },
        "postgresql_up_path": {
          "title": "Postgresql Up Path",
          "type": "string"
        },
        "postgresql_up_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Postgresql Up Sha256",
          "type": "string"
        },
        "reversible": {
          "title": "Reversible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "sqlite_down_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlite Down Path"
        },
        "sqlite_down_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlite Down Sha256"
        },
        "sqlite_up_path": {
          "title": "Sqlite Up Path",
          "type": "string"
        },
        "sqlite_up_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sqlite Up Sha256",
          "type": "string"
        }
      },
      "required": [
        "migration_id",
        "sequence",
        "name",
        "reversible",
        "compatibility_phase",
        "sqlite_up_path",
        "sqlite_up_sha256",
        "postgresql_up_path",
        "postgresql_up_sha256"
      ],
      "title": "MigrationRecord",
      "type": "object"
    }
  },
  "$id": "https://project-pipeline.local/schemas/migration_catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_id": {
      "const": "PROJECT-PIPELINE-DATABASE-MIGRATIONS",
      "default": "PROJECT-PIPELINE-DATABASE-MIGRATIONS",
      "title": "Catalog Id",
      "type": "string"
    },
    "migrations": {
      "items": {
        "$ref": "#/$defs/MigrationRecord"
      },
      "title": "Migrations",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "migrations"
  ],
  "title": "MigrationCatalog",
  "type": "object"
}
