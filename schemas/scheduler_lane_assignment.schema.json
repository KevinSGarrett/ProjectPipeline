{
  "$defs": {
    "AccessMode": {
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "ResourceClaim": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "EXCLUSIVE"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "quantity": {
          "default": 1,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_type"
      ],
      "title": "ResourceClaim",
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "PATH",
        "SYMBOL",
        "MODULE",
        "DATABASE",
        "SCHEMA",
        "API_CONTRACT",
        "CONFIGURATION",
        "INFRASTRUCTURE",
        "DOCKER",
        "ENVIRONMENT",
        "RELEASE",
        "FIXTURE",
        "SERVICE",
        "PORT",
        "GPU",
        "GPU_MEMORY_MB",
        "CPU_SLOT",
        "MEMORY_MB",
        "DISK_MB",
        "NETWORK_SLOT",
        "PROCESS_SLOT",
        "CONCURRENCY_SLOT",
        "PROVIDER_SLOT",
        "REVIEW_SLOT"
      ],
      "title": "ResourceType",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/scheduler_lane_assignment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "lane_id": {
      "title": "Lane Id",
      "type": "string"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "utility_score": {
      "minimum": 0,
      "title": "Utility Score",
      "type": "integer"
    }
  },
  "required": [
    "lane_id",
    "task_id",
    "rank",
    "utility_score"
  ],
  "title": "LaneAssignment",
  "type": "object"
}
