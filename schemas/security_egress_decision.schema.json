        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "CONSTRAIN"
      ],
      "title": "PolicyDisposition",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/security_egress_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
