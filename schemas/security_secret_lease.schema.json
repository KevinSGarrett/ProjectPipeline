{
  "$id": "https://project-pipeline.local/schemas/security_secret_lease.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at_utc": {
      "format": "date-time",
      "title": "Expires At Utc",
      "type": "string"
    },
    "identity_id": {
      "title": "Identity Id",
      "type": "string"
    },
    "issued_at_utc": {
      "format": "date-time",
      "title": "Issued At Utc",
      "type": "string"
    },
    "issued_by": {
      "title": "Issued By",
      "type": "string"
    },
    "lease_id": {
      "title": "Lease Id",
      "type": "string"
    },
    "materialization_count": {
      "default": 0,
      "minimum": 0,
      "title": "Materialization Count",
      "type": "integer"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "revoked_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At Utc"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_ref_id": {
      "title": "Secret Ref Id",
      "type": "string"
    },
    "target": {
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "secret_ref_id",
    "identity_id",
    "project_id",
    "target",
    "operation",
    "issued_by",
    "expires_at_utc"
  ],
  "title": "SecretLease",
  "type": "object"
}
