{
  "$defs": {
    "ReviewerIdentity": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "context_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Context Fingerprint",
          "type": "string"
        },
        "implementation_context_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Implementation Context Fingerprint",
          "type": "string"
        },
        "implementer_id": {
          "maxLength": 191,
          "minLength": 1,
          "title": "Implementer Id",
          "type": "string"
        },
        "reviewer_id": {
          "maxLength": 191,
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "implementer_id",
        "context_fingerprint",
        "implementation_context_fingerprint"
      ],
      "title": "ReviewerIdentity",
      "type": "object"
    }
  },
  "$id": "https://project-pipeline.local/schemas/assurance_independent_review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocking_finding_count": {
      "minimum": 0,
      "title": "Blocking Finding Count",
      "type": "integer"
    },
    "completed_at_utc": {
      "format": "date-time",
      "title": "Completed At Utc",
      "type": "string"
    },
    "criterion_ids": {
      "items": {
        "type": "string"
      },
      "title": "Criterion Ids",
      "type": "array"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "identity": {
      "$ref": "#/$defs/ReviewerIdentity"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_id": {
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "subject_id",
    "identity",
    "criterion_ids",
    "finding_count",
    "blocking_finding_count"
  ],
  "title": "IndependentReview",
  "type": "object"
}
