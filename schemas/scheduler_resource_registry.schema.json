{
  "$defs": {
    "AccessMode": {
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "ResourceClaim": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "EXCLUSIVE"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "quantity": {
          "default": 1,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_type"
      ],
      "title": "ResourceClaim",
      "type": "object"
    },
    "ResourceLease": {
      "additionalProperties": false,
      "properties": {
        "acquired_at_utc": {
          "format": "date-time",
          "title": "Acquired At Utc",
          "type": "string"
        },
        "claim": {
          "$ref": "#/$defs/ResourceClaim"
        },
        "expires_at_utc": {
          "format": "date-time",
          "title": "Expires At Utc",
          "type": "string"
        },
        "fencing_token": {
          "minimum": 1,
          "title": "Fencing Token",
          "type": "integer"
        },
        "holder_id": {
          "maxLength": 191,
          "minLength": 1,
          "title": "Holder Id",
          "type": "string"
        },
        "lease_id": {
          "title": "Lease Id",
          "type": "string"
        },
        "released_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Released At Utc"
        },
        "renewed_at_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewed At Utc"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "lease_id",
        "task_id",
        "holder_id",
        "claim",
        "fencing_token",
        "expires_at_utc"
      ],
      "title": "ResourceLease",
      "type": "object"
    },
    "ResourcePool": {
      "additionalProperties": false,
      "properties": {
        "capacity_units": {
          "minimum": 1,
          "title": "Capacity Units",
          "type": "integer"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        },
        "reserved_units": {
          "default": 0,
          "minimum": 0,
          "title": "Reserved Units",
          "type": "integer"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_type",
        "capacity_units"
      ],
      "title": "ResourcePool",
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "PATH",
        "SYMBOL",
        "MODULE",
        "DATABASE",
        "SCHEMA",
        "API_CONTRACT",
        "CONFIGURATION",
        "INFRASTRUCTURE",
        "DOCKER",
        "ENVIRONMENT",
        "RELEASE",
        "FIXTURE",
        "SERVICE",
        "PORT",
        "GPU",
        "GPU_MEMORY_MB",
        "CPU_SLOT",
        "MEMORY_MB",
        "DISK_MB",
        "NETWORK_SLOT",
        "PROCESS_SLOT",
        "CONCURRENCY_SLOT",
        "PROVIDER_SLOT",
        "REVIEW_SLOT"
      ],
      "title": "ResourceType",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/scheduler_resource_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_leases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceLease"
      },
      "title": "Active Leases",
      "type": "array"
    },
    "observed_at_utc": {
      "format": "date-time",
      "title": "Observed At Utc",
      "type": "string"
    },
    "pools": {
      "items": {
        "$ref": "#/$defs/ResourcePool"
      },
      "title": "Pools",
      "type": "array"
    },
    "registry_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Registry Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "registry_id",
    "pools"
  ],
  "title": "ResourceRegistrySnapshot",
  "type": "object"
}
