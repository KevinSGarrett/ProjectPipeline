{
  "$id": "https://project-pipeline.local/schemas/github_branch_protection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_deletions": {
      "default": false,
      "title": "Allow Deletions",
      "type": "boolean"
    },
    "allow_force_pushes": {
      "default": false,
      "title": "Allow Force Pushes",
      "type": "boolean"
    },
    "branch": {
      "title": "Branch",
      "type": "string"
    },
    "contexts_only_required_checks": {
      "default": false,
      "title": "Contexts Only Required Checks",
      "type": "boolean"
    },
    "dismiss_stale_reviews": {
      "default": true,
      "title": "Dismiss Stale Reviews",
      "type": "boolean"
    },
    "enforce_admins": {
      "default": true,
      "title": "Enforce Admins",
      "type": "boolean"
    },
    "protected": {
      "title": "Protected",
      "type": "boolean"
    },
    "repository_slug": {
      "title": "Repository Slug",
      "type": "string"
    },
    "require_code_owner_reviews": {
      "default": false,
      "title": "Require Code Owner Reviews",
      "type": "boolean"
    },
    "require_conversation_resolution": {
      "default": true,
      "title": "Require Conversation Resolution",
      "type": "boolean"
    },
    "require_last_push_approval": {
      "default": false,
      "title": "Require Last Push Approval",
      "type": "boolean"
    },
    "require_linear_history": {
      "default": true,
      "title": "Require Linear History",
      "type": "boolean"
    },
    "required_approving_review_count": {
      "default": 0,
      "minimum": 0,
      "title": "Required Approving Review Count",
      "type": "integer"
    },
    "required_status_check_app_ids": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Required Status Check App Ids",
      "type": "array"
    },
    "required_status_checks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Status Checks",
      "type": "array"
    },
    "required_status_checks_strict": {
      "default": true,
      "title": "Required Status Checks Strict",
      "type": "boolean"
    },
    "reviews_object_present": {
      "default": true,
      "title": "Reviews Object Present",
      "type": "boolean"
    }
  },
  "required": [
    "repository_slug",
    "branch",
    "protected"
  ],
  "title": "GitHubBranchProtection",
  "type": "object"
}
