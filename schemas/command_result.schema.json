{
  "$defs": {
    "CommandStatus": {
      "enum": [
        "SUCCEEDED",
        "REJECTED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "CommandStatus",
      "type": "string"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "aggregate_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_type": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Aggregate Type",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event Type",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "occurred_at_utc": {
          "format": "date-time",
          "title": "Occurred At Utc",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "producer": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Producer",
          "type": "string"
        },
        "project_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "default": 0,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "workflow_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Id"
        }
      },
      "required": [
        "event_type",
        "project_id",
        "producer",
        "correlation_id",
        "aggregate_type",
        "aggregate_id"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "StateTransition": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Command Id",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Entity Type",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "next_state": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Next State",
          "type": "string"
        },
        "occurred_at_utc": {
          "format": "date-time",
          "title": "Occurred At Utc",
          "type": "string"
        },
        "previous_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous State"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "transition_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "next_state",
        "reason",
        "command_id",
        "correlation_id"
      ],
      "title": "StateTransition",
      "type": "object"
    }
  },
  "$id": "https://project-pipeline.local/schemas/command_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Command Id",
      "type": "string"
    },
    "command_type": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Command Type",
      "type": "string"
    },
    "completed_at_utc": {
      "format": "date-time",
      "title": "Completed At Utc",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EventEnvelope"
      },
      "title": "Events",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "project_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "replayed": {
      "default": false,
      "title": "Replayed",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CommandStatus"
    },
    "transitions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StateTransition"
      },
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "command_id",
    "command_type",
    "project_id",
    "correlation_id",
    "idempotency_key",
    "status"
  ],
  "title": "CommandResult",
  "type": "object"
}
