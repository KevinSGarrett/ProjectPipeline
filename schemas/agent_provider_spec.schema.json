{
  "$defs": {
    "AccessMode": {
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "ExecutionMode": {
      "enum": [
        "LOCAL_PROCESS",
        "HOSTED_API",
        "SUBSCRIPTION_TOOL",
        "BROWSER",
        "MOCK"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "ResourceClaim": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "EXCLUSIVE"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "quantity": {
          "default": 1,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_type"
      ],
      "title": "ResourceClaim",
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "PATH",
        "SYMBOL",
        "MODULE",
        "DATABASE",
        "SCHEMA",
        "API_CONTRACT",
        "CONFIGURATION",
        "INFRASTRUCTURE",
        "DOCKER",
        "ENVIRONMENT",
        "RELEASE",
        "FIXTURE",
        "SERVICE",
        "PORT",
        "GPU",
        "GPU_MEMORY_MB",
        "CPU_SLOT",
        "MEMORY_MB",
        "DISK_MB",
        "NETWORK_SLOT",
        "PROCESS_SLOT",
        "CONCURRENCY_SLOT",
        "PROVIDER_SLOT",
        "REVIEW_SLOT"
      ],
      "title": "ResourceType",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/agent_provider_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "title": "Adapter Id",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "constraints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "cost_behavior": {
      "default": "unknown",
      "title": "Cost Behavior",
      "type": "string"
    },
    "data_egress": {
      "default": true,
      "title": "Data Egress",
      "type": "boolean"
    },
    "display_name": {
      "maxLength": 191,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "local": {
      "default": false,
      "title": "Local",
      "type": "boolean"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "resource_claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceClaim"
      },
      "title": "Resource Claims",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subscription_backed": {
      "default": false,
      "title": "Subscription Backed",
      "type": "boolean"
    }
  },
  "required": [
    "provider_id",
    "display_name",
    "adapter_id",
    "execution_mode",
    "capabilities"
  ],
  "title": "ProviderSpec",
  "type": "object"
}
