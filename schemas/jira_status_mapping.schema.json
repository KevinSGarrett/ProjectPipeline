        "BACKLOG",
        "READY",
        "IN_PROGRESS",
        "REVIEW",
        "VALIDATION",
        "MERGE_READY",
        "BLOCKED",
        "FAILED",
        "CANCELLED",
        "DEFERRED",
        "DONE"
      ],
      "title": "JiraLifecycleState",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/jira_status_mapping.schema.json",
