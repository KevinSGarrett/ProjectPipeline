{
  "$defs": {
    "CompletionProjectionState": {
      "enum": [
        "INCOMPLETE",
        "BLOCKED",
        "FAILED",
        "READY_FOR_COMPLETION_GATE"
      ],
      "title": "CompletionProjectionState",
      "type": "string"
    },
    "ControlCohortCounts": {
      "additionalProperties": false,
      "description": "Labeled same-snapshot denominators for facts, eligibility, and readiness.",
      "properties": {
        "dependency_ready": {
          "default": 0,
          "minimum": 0,
          "title": "Dependency Ready",
          "type": "integer"
        },
        "eligibility_already_active": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Already Active",
          "type": "integer"
        },
        "eligibility_blocked": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Blocked",
          "type": "integer"
        },
        "eligibility_blocked_external": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Blocked External",
          "type": "integer"
        },
        "eligibility_eligible": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Eligible",
          "type": "integer"
        },
        "eligibility_policy_denied": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Policy Denied",
          "type": "integer"
        },
        "eligibility_product_scope_paused": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Product Scope Paused",
          "type": "integer"
        },
        "eligibility_reconciliation": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Reconciliation",
          "type": "integer"
        },
        "eligibility_terminal": {
          "default": 0,
          "minimum": 0,
          "title": "Eligibility Terminal",
          "type": "integer"
        },
        "leaf_reconciliation_facts": {
          "default": 0,
          "minimum": 0,
          "title": "Leaf Reconciliation Facts",
          "type": "integer"
        },
        "reconciliation_facts": {
          "default": 0,
          "minimum": 0,
          "title": "Reconciliation Facts",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "structural_container_facts": {
          "default": 0,
          "minimum": 0,
          "title": "Structural Container Facts",
          "type": "integer"
        },
        "total_work_items": {
          "default": 0,
          "minimum": 0,
          "title": "Total Work Items",
          "type": "integer"
        }
      },
      "title": "ControlCohortCounts",
      "type": "object"
    }
  },
  "$id": "https://project-pipeline.local/schemas/control_completion_projection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_requirements": {
      "minimum": 0,
      "title": "Accepted Requirements",
      "type": "integer"
    },
    "active_work_items": {
      "minimum": 0,
      "title": "Active Work Items",
      "type": "integer"
    },
    "blocked_work_items": {
      "minimum": 0,
      "title": "Blocked Work Items",
      "type": "integer"
    },
    "cohorts": {
      "$ref": "#/$defs/ControlCohortCounts"
    },
    "completed_work_items": {
      "minimum": 0,
      "title": "Completed Work Items",
      "type": "integer"
    },
    "failed_work_items": {
      "minimum": 0,
      "title": "Failed Work Items",
      "type": "integer"
    },
    "final_completion_gate_satisfied": {
      "default": false,
      "title": "Final Completion Gate Satisfied",
      "type": "boolean"
    },
    "generated_at_utc": {
      "format": "date-time",
      "title": "Generated At Utc",
      "type": "string"
    },
    "implemented_or_external_blocked_requirements": {
      "minimum": 0,
      "title": "Implemented Or External Blocked Requirements",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "projection_id": {
      "title": "Projection Id",
      "type": "string"
    },
    "ready_work_items": {
      "minimum": 0,
      "title": "Ready Work Items",
      "type": "integer"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CompletionProjectionState"
    },
    "total_work_items": {
      "minimum": 0,
      "title": "Total Work Items",
      "type": "integer"
    },
    "verification_eligible": {
      "title": "Verification Eligible",
      "type": "boolean"
    }
  },
  "required": [
    "projection_id",
    "project_id",
    "state",
    "total_work_items",
    "completed_work_items",
    "active_work_items",
    "blocked_work_items",
    "failed_work_items",
    "accepted_requirements",
    "implemented_or_external_blocked_requirements",
    "ready_work_items",
    "verification_eligible",
    "reasons"
  ],
  "title": "CompletionProjection",
  "type": "object"
}
