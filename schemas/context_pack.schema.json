{
  "$defs": {
    "ContextItem": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "context_key": {
          "title": "Context Key",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContextSourceKind"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "source_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "trust": {
          "$ref": "#/$defs/ContextTrust"
        }
      },
      "required": [
        "item_id",
        "context_key",
        "kind",
        "content",
        "revision_id",
        "trust",
        "sensitivity",
        "content_sha256"
      ],
      "title": "ContextItem",
      "type": "object"
    },
    "ContextSourceKind": {
      "enum": [
        "SOURCE",
        "REQUIREMENT",
        "PLAN",
        "JIRA",
        "DECISION",
        "EVIDENCE",
        "POLICY",
        "INSTRUCTION",
        "REPOSITORY_MAP",
        "SOURCE_FILE",
        "TEST",
        "DIFF",
        "REVIEW_RUBRIC",
        "DOCUMENT",
        "OTHER"
      ],
      "title": "ContextSourceKind",
      "type": "string"
    },
    "ContextTrust": {
      "enum": [
        "GOVERNING",
        "AUTHORITATIVE",
        "SOURCE_CONTROLLED",
        "VERIFIED_EXTERNAL",
        "UNTRUSTED_REPOSITORY",
        "UNTRUSTED_EXTERNAL"
      ],
      "title": "ContextTrust",
      "type": "string"
    },
    "CoverageReport": {
      "additionalProperties": false,
      "properties": {
        "missing_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Keys",
          "type": "array"
        },
        "represented_count": {
          "minimum": 0,
          "title": "Represented Count",
          "type": "integer"
        },
        "required_count": {
          "minimum": 0,
          "title": "Required Count",
          "type": "integer"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "required_count",
        "represented_count",
        "score"
      ],
      "title": "CoverageReport",
      "type": "object"
    },
    "Sensitivity": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "title": "Sensitivity",
      "type": "integer"
    }
  },
  "$id": "https://project-pipeline.local/schemas/context_pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "coverage": {
      "$ref": "#/$defs/CoverageReport"
    },
    "delegation_id": {
      "title": "Delegation Id",
      "type": "string"
    },
    "generated_at_utc": {
      "format": "date-time",
      "title": "Generated At Utc",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ContextItem"
      },
      "title": "Items",
      "type": "array"
    },
    "omissions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Omissions",
      "type": "array"
    },
    "pack_id": {
      "title": "Pack Id",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "redaction_count": {
      "default": 0,
      "minimum": 0,
      "title": "Redaction Count",
      "type": "integer"
    },
    "stale_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Stale Keys",
      "type": "array"
    },
    "total_chars": {
      "minimum": 0,
      "title": "Total Chars",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "pack_id",
    "delegation_id",
    "policy_version",
    "generated_at_utc",
    "items",
    "coverage",
    "total_chars",
    "content_sha256"
  ],
  "title": "ContextPack",
  "type": "object"
}
