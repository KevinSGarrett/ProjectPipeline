{
  "$defs": {
    "JiraAuthorityMode": {
      "enum": [
        "SOURCE_CONTROLLED_LOCAL",
        "REMOTE_COLLABORATIVE"
      ],
      "title": "JiraAuthorityMode",
      "type": "string"
    },
    "JiraConflictKind": {
      "enum": [
        "DUPLICATE_REMOTE_MAPPING",
        "LOCAL_AND_REMOTE_DIVERGED",
        "REMOTE_ONLY_ISSUE",
        "STATUS_UNMAPPED",
        "HIERARCHY_MISMATCH",
        "STALE_REMOTE_OBSERVATION",
        "UNKNOWN_WRITE_OUTCOME",
        "UNSUPPORTED_REMOTE_TYPE",
        "HUMAN_DECISION_REQUIRED"
      ],
      "title": "JiraConflictKind",
      "type": "string"
    },
    "JiraOperationState": {
      "enum": [
        "PLANNED",
        "PENDING",
        "APPLIED",
        "RECONCILED",
        "FAILED",
        "UNKNOWN_OUTCOME",
        "REJECTED"
      ],
      "title": "JiraOperationState",
      "type": "string"
    },
    "JiraSyncConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/JiraConflictKind"
        },
        "local_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Id"
        },
        "remote_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Key"
        },
        "required_resolution": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Required Resolution",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "kind",
        "description",
        "required_resolution"
      ],
      "title": "JiraSyncConflict",
      "type": "object"
    },
    "JiraSyncOperation": {
      "additionalProperties": false,
      "properties": {
        "expected_remote_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Remote Version"
        },
        "idempotency_key": {
          "maxLength": 255,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "local_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Id"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "operation_type": {
          "$ref": "#/$defs/JiraSyncOperationType"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "remote_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remote Key"
        },
        "request_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "requires_human_approval": {
          "default": false,
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "requires_remote_write": {
          "title": "Requires Remote Write",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/JiraOperationState",
          "default": "PLANNED"
        }
      },
      "required": [
        "operation_id",
        "operation_type",
        "idempotency_key",
        "request_fingerprint",
        "requires_remote_write"
      ],
      "title": "JiraSyncOperation",
      "type": "object"
    },
    "JiraSyncOperationType": {
      "enum": [
        "CREATE_REMOTE_ISSUE",
        "UPDATE_REMOTE_FIELDS",
        "TRANSITION_REMOTE_ISSUE",
        "ADD_REMOTE_COMMENT",
        "CREATE_REMOTE_LINK",
        "RECORD_REMOTE_MAPPING",
        "IMPORT_REMOTE_ISSUE",
        "ACCEPT_REMOTE_FIELDS",
        "NO_OPERATION"
      ],
      "title": "JiraSyncOperationType",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/jira_reconciliation_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_mode": {
      "$ref": "#/$defs/JiraAuthorityMode"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/JiraSyncConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "local_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Local Fingerprint",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/JiraSyncOperation"
      },
      "title": "Operations",
      "type": "array"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "project_key": {
      "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
      "title": "Project Key",
      "type": "string"
    },
    "remote_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Remote Fingerprint",
      "type": "string"
    },
    "remote_snapshot_id": {
      "title": "Remote Snapshot Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "project_key",
    "authority_mode",
    "local_fingerprint",
    "remote_snapshot_id",
    "remote_fingerprint",
    "operations",
    "conflicts"
  ],
  "title": "JiraReconciliationPlan",
  "type": "object"
}
