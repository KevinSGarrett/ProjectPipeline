{
  "$defs": {
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "SECRET",
        "LOCAL_ONLY"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "SecretBackendKind": {
      "enum": [
        "ENVIRONMENT",
        "FILE",
        "SOPS",
        "AGE",
        "OPENBAO"
      ],
      "title": "SecretBackendKind",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/security_secret_reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_operations": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Operations",
      "type": "array"
    },
    "allowed_target_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Target Prefixes",
      "type": "array"
    },
    "backend": {
      "$ref": "#/$defs/SecretBackendKind"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification",
      "default": "SECRET"
    },
    "logical_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Logical Name",
      "type": "string"
    },
    "reference": {
      "maxLength": 1000,
      "minLength": 3,
      "title": "Reference",
      "type": "string"
    },
    "rotation_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rotation Hint"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secret_ref_id": {
      "title": "Secret Ref Id",
      "type": "string"
    }
  },
  "required": [
    "secret_ref_id",
    "logical_name",
    "backend",
    "reference",
    "allowed_operations",
    "allowed_target_prefixes"
  ],
  "title": "SecretCapabilityReference",
  "type": "object"
}
