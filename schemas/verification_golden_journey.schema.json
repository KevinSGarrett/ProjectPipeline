{
  "$id": "https://project-pipeline.local/schemas/verification_golden_journey.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_steps": {
      "items": {
        "type": "string"
      },
      "title": "Action Steps",
      "type": "array"
    },
    "cleanup_steps": {
      "items": {
        "type": "string"
      },
      "title": "Cleanup Steps",
      "type": "array"
    },
    "environment": {
      "maxLength": 500,
      "minLength": 3,
      "title": "Environment",
      "type": "string"
    },
    "evidence_expectations": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Expectations",
      "type": "array"
    },
    "expected_results": {
      "items": {
        "type": "string"
      },
      "title": "Expected Results",
      "type": "array"
    },
    "journey_id": {
      "title": "Journey Id",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 8,
      "title": "Objective",
      "type": "string"
    },
    "required_observations": {
      "items": {
        "type": "string"
      },
      "title": "Required Observations",
      "type": "array"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requirement Ids",
      "type": "array"
    },
    "risk": {
      "default": "HIGH",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Risk",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "setup_steps": {
      "items": {
        "type": "string"
      },
      "title": "Setup Steps",
      "type": "array"
    }
  },
  "required": [
    "journey_id",
    "name",
    "objective",
    "requirement_ids",
    "environment",
    "setup_steps",
    "action_steps",
    "expected_results",
    "cleanup_steps",
    "evidence_expectations",
    "required_observations"
  ],
  "title": "GoldenJourneyDefinition",
  "type": "object"
}
