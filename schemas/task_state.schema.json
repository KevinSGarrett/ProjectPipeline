{
  "$defs": {
    "TaskLifecycleState": {
      "enum": [
        "BACKLOG",
        "READY",
        "CLAIMED",
        "IN_PROGRESS",
        "BLOCKED",
        "IN_REVIEW",
        "VALIDATING",
        "DONE",
        "FAILED",
        "CANCELLED"
      ],
      "title": "TaskLifecycleState",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/task_state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocked_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Reason"
    },
    "blocker_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blocker Ids",
      "type": "array"
    },
    "dependency_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependency Ids",
      "type": "array"
    },
    "last_transition_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Transition Id"
    },
    "owner_id": {
      "anyOf": [
        {
          "maxLength": 191,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner Id"
    },
    "priority": {
      "default": "P1",
      "pattern": "^P[0-3]$",
      "title": "Priority",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/TaskLifecycleState"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "updated_at_utc": {
      "format": "date-time",
      "title": "Updated At Utc",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "task_id",
    "project_id",
    "state"
  ],
  "title": "TaskStateRecord",
  "type": "object"
}
