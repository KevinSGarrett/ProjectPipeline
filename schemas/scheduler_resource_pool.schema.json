{
  "$defs": {
    "ResourceType": {
      "enum": [
        "PATH",
        "SYMBOL",
        "MODULE",
        "DATABASE",
        "SCHEMA",
        "API_CONTRACT",
        "CONFIGURATION",
        "INFRASTRUCTURE",
        "DOCKER",
        "ENVIRONMENT",
        "RELEASE",
        "FIXTURE",
        "SERVICE",
        "PORT",
        "GPU",
        "GPU_MEMORY_MB",
        "CPU_SLOT",
        "MEMORY_MB",
        "DISK_MB",
        "NETWORK_SLOT",
        "PROCESS_SLOT",
        "CONCURRENCY_SLOT",
        "PROVIDER_SLOT",
        "REVIEW_SLOT"
      ],
      "title": "ResourceType",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/scheduler_resource_pool.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capacity_units": {
      "minimum": 1,
      "title": "Capacity Units",
      "type": "integer"
    },
    "machine_id": {
      "anyOf": [
        {
          "maxLength": 191,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Machine Id"
    },
    "observed": {
      "default": false,
      "title": "Observed",
      "type": "boolean"
    },
    "reserved_units": {
      "default": 0,
      "minimum": 0,
      "title": "Reserved Units",
      "type": "integer"
    },
    "resource_key": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Resource Key",
      "type": "string"
    },
    "resource_type": {
      "$ref": "#/$defs/ResourceType"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "resource_key",
    "resource_type",
    "capacity_units"
  ],
  "title": "ResourcePool",
  "type": "object"
}
