{
  "$defs": {
    "AccessMode": {
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ],
      "title": "AccessMode",
      "type": "string"
    },
    "AdmissionDecision": {
      "additionalProperties": false,
      "properties": {
        "admitted": {
          "title": "Admitted",
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AdmissionState"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "state",
        "admitted"
      ],
      "title": "AdmissionDecision",
      "type": "object"
    },
    "AdmissionState": {
      "enum": [
        "ADMITTED",
        "CONFLICT",
        "CAPACITY_EXHAUSTED",
        "LEASE_UNAVAILABLE",
        "BACKPRESSURE",
        "POLICY_DENIED",
        "WORKSPACE_UNSAFE"
      ],
      "title": "AdmissionState",
      "type": "string"
    },
    "BackpressureDecision": {
      "additionalProperties": false,
      "properties": {
        "admit_new_work": {
          "title": "Admit New Work",
          "type": "boolean"
        },
        "lane_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Lane Fraction",
          "type": "number"
        },
        "mode": {
          "$ref": "#/$defs/BackpressureMode"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "lane_fraction",
        "admit_new_work"
      ],
      "title": "BackpressureDecision",
      "type": "object"
    },
    "BackpressureMode": {
      "enum": [
        "NORMAL",
        "CONGESTED",
        "BROWNOUT",
        "HALT_NEW_WORK"
      ],
      "title": "BackpressureMode",
      "type": "string"
    },
    "ConflictEdge": {
      "additionalProperties": false,
      "properties": {
        "left_task_id": {
          "title": "Left Task Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "right_task_id": {
          "title": "Right Task Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "left_task_id",
        "right_task_id",
        "reasons"
      ],
      "title": "ConflictEdge",
      "type": "object"
    },
    "LaneAssignment": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "utility_score": {
          "minimum": 0,
          "title": "Utility Score",
          "type": "integer"
        }
      },
      "required": [
        "lane_id",
        "task_id",
        "rank",
        "utility_score"
      ],
      "title": "LaneAssignment",
      "type": "object"
    },
    "ResourceClaim": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/AccessMode",
          "default": "EXCLUSIVE"
        },
        "machine_id": {
          "anyOf": [
            {
              "maxLength": 191,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Machine Id"
        },
        "purpose": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "quantity": {
          "default": 1,
          "maximum": 10000000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_type": {
          "$ref": "#/$defs/ResourceType"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_type"
      ],
      "title": "ResourceClaim",
      "type": "object"
    },
    "ResourceType": {
      "enum": [
        "PATH",
        "SYMBOL",
        "MODULE",
        "DATABASE",
        "SCHEMA",
        "API_CONTRACT",
        "CONFIGURATION",
        "INFRASTRUCTURE",
        "DOCKER",
        "ENVIRONMENT",
        "RELEASE",
        "FIXTURE",
        "SERVICE",
        "PORT",
        "GPU",
        "GPU_MEMORY_MB",
        "CPU_SLOT",
        "MEMORY_MB",
        "DISK_MB",
        "NETWORK_SLOT",
        "PROCESS_SLOT",
        "CONCURRENCY_SLOT",
        "PROVIDER_SLOT",
        "REVIEW_SLOT"
      ],
      "title": "ResourceType",
      "type": "string"
    },
    "SchedulerPlan": {
      "additionalProperties": false,
      "properties": {
        "admissions": {
          "items": {
            "$ref": "#/$defs/AdmissionDecision"
          },
          "title": "Admissions",
          "type": "array"
        },
        "backpressure": {
          "$ref": "#/$defs/BackpressureDecision"
        },
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ConflictEdge"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "control_snapshot_id": {
          "title": "Control Snapshot Id",
          "type": "string"
        },
        "generated_at_utc": {
          "format": "date-time",
          "title": "Generated At Utc",
          "type": "string"
        },
        "lane_limit": {
          "minimum": 0,
          "title": "Lane Limit",
          "type": "integer"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/LaneAssignment"
          },
          "title": "Lanes",
          "type": "array"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "registry_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_method": {
          "enum": [
            "EXACT_BOUNDED",
            "DETERMINISTIC_GREEDY",
            "ORTOOLS_CP_SAT"
          ],
          "title": "Selection Method",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "project_id",
        "control_snapshot_id",
        "registry_id",
        "backpressure",
        "selection_method",
        "candidate_count",
        "lane_limit",
        "lanes",
        "conflicts",
        "admissions"
      ],
      "title": "SchedulerPlan",
      "type": "object"
    }
  },
  "$id": "https://project-pipeline.local/schemas/scheduler_simulation_result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertions_passed": {
      "title": "Assertions Passed",
      "type": "boolean"
    },
    "expected_lane_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Lane Count"
    },
    "findings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "plan": {
      "$ref": "#/$defs/SchedulerPlan"
    },
    "scenario_name": {
      "maxLength": 191,
      "minLength": 1,
      "title": "Scenario Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "simulation_id": {
      "title": "Simulation Id",
      "type": "string"
    }
  },
  "required": [
    "simulation_id",
    "scenario_name",
    "plan",
    "assertions_passed"
  ],
  "title": "SchedulerSimulationResult",
  "type": "object"
}
