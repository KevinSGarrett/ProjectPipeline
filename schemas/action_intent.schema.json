{
  "$defs": {
    "ApprovalState": {
      "enum": [
        "NOT_REQUIRED",
        "REQUIRED",
        "APPROVED",
        "DENIED"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/action_intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Action Id",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Actor Id",
      "type": "string"
    },
    "approval_state": {
      "$ref": "#/$defs/ApprovalState",
      "default": "REQUIRED"
    },
    "authority": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Authority",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "operation": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Operation",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/RiskLevel",
      "default": "MEDIUM"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "target": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "authority",
    "target",
    "operation",
    "idempotency_key",
    "correlation_id"
  ],
  "title": "ActionIntent",
  "type": "object"
}
