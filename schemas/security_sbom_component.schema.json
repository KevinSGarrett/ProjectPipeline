{
  "$id": "https://project-pipeline.local/schemas/security_sbom_component.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "title": "Component Id",
      "type": "string"
    },
    "component_type": {
      "title": "Component Type",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "metadata_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Sha256"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "component_id",
    "name",
    "version",
    "component_type"
  ],
  "title": "SBOMComponent",
  "type": "object"
}
