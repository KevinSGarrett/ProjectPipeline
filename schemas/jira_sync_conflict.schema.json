{
  "$defs": {
    "JiraConflictKind": {
      "enum": [
        "DUPLICATE_REMOTE_MAPPING",
        "LOCAL_AND_REMOTE_DIVERGED",
        "REMOTE_ONLY_ISSUE",
        "STATUS_UNMAPPED",
        "HIERARCHY_MISMATCH",
        "STALE_REMOTE_OBSERVATION",
        "UNKNOWN_WRITE_OUTCOME",
        "UNSUPPORTED_REMOTE_TYPE",
        "HUMAN_DECISION_REQUIRED"
      ],
      "title": "JiraConflictKind",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/jira_sync_conflict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conflict_id": {
      "title": "Conflict Id",
      "type": "string"
    },
    "description": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Fields",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/JiraConflictKind"
    },
    "local_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Id"
    },
    "remote_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remote Key"
    },
    "required_resolution": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Required Resolution",
      "type": "string"
    }
  },
  "required": [
    "conflict_id",
    "kind",
    "description",
    "required_resolution"
  ],
  "title": "JiraSyncConflict",
  "type": "object"
}
