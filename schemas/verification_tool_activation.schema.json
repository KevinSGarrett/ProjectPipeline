{
  "$defs": {
    "ToolActivationState": {
      "enum": [
        "EXECUTED",
        "ADAPTER_IMPLEMENTED",
        "QUALIFIED_NOT_INSTALLED",
        "PATTERN_ONLY",
        "DEFERRED_TO_LATER_SURFACE"
      ],
      "title": "ToolActivationState",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/verification_tool_activation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_id": {
      "title": "Activation Id",
      "type": "string"
    },
    "activation_phase": {
      "title": "Activation Phase",
      "type": "string"
    },
    "evidence_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Paths",
      "type": "array"
    },
    "executable_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executable Path"
    },
    "installed_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installed Version"
    },
    "integration_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Integration Paths",
      "type": "array"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Revision"
    },
    "state": {
      "$ref": "#/$defs/ToolActivationState"
    },
    "upstream_id": {
      "title": "Upstream Id",
      "type": "string"
    }
  },
  "required": [
    "activation_id",
    "upstream_id",
    "repository",
    "state",
    "activation_phase",
    "reason"
  ],
  "title": "VerificationToolActivation",
  "type": "object"
}
