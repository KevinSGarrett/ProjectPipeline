{
  "$defs": {
    "ActionIntent": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Action Id",
          "type": "string"
        },
        "actor_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "approval_state": {
          "$ref": "#/$defs/ApprovalState",
          "default": "REQUIRED"
        },
        "authority": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Authority",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 256,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "operation": {
          "maxLength": 191,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel",
          "default": "MEDIUM"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        },
        "target": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "authority",
        "target",
        "operation",
        "idempotency_key",
        "correlation_id"
      ],
      "title": "ActionIntent",
      "type": "object"
    },
    "ApprovalState": {
      "enum": [
        "NOT_REQUIRED",
        "REQUIRED",
        "APPROVED",
        "DENIED"
      ],
      "title": "ApprovalState",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "$id": "https://project-pipeline.local/schemas/command_envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_intent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionIntent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actor_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Actor Id",
      "type": "string"
    },
    "authority_scope": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Authority Scope",
      "type": "array"
    },
    "command_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Command Id",
      "type": "string"
    },
    "command_type": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Command Type",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "issued_at_utc": {
      "format": "date-time",
      "title": "Issued At Utc",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "project_id": {
      "maxLength": 191,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "command_type",
    "project_id",
    "actor_id",
    "correlation_id",
    "idempotency_key"
  ],
  "title": "CommandEnvelope",
  "type": "object"
}
