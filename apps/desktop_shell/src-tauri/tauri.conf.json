{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Pipeline Command Center",
  "version": "0.10.0",
  "identifier": "com.projectpipeline.commandcenter",
  "build": {
    "beforeDevCommand": "npm --prefix ../../command_center run dev",
    "beforeBuildCommand": "npm --prefix ../../command_center run build",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../../command_center/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Pipeline Command Center",
        "width": 1500,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ws://127.0.0.1:8765; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
