# ============================================================================
# Project Pipeline - complete environment example
# ============================================================================
# Copy this file to .env and populate only the integrations you actually use.
# NEVER commit .env or real credentials.
#
# Secret-reference convention used by Project Pipeline:
#   *_REF=env://NAME   -> configuration stores only the reference.
#   NAME=<secret>      -> the secret value exists only in the environment.
#
# Authentication model notes:
# - Gemini CLI is intentionally SUBSCRIPTION / GOOGLE-ACCOUNT authenticated.
#   Run `gemini` and sign in with the Google account tied to the subscription.
#   Do NOT add GEMINI_API_KEY for the intended subscription-backed Gemini worker.
# - Codex CLI/Desktop and ChatGPT subscription sessions authenticate through
#   their own account/login flows. They do not require a project .env secret.
# - OPENAI_API_KEY below is only for the separate metered OpenAI API provider.
# - Anthropic is intentionally NOT included. A dormant/generic adapter does not
#   make Anthropic an operational dependency of this project.
#
# Variable categories:
#   [CORE]       read directly by Project Pipeline runtime configuration.
#   [SECRET]     secret material referenced by Project Pipeline or its adapters.
#   [TOOL]       read by an external CLI/runtime launched by the platform.
#   [DEPLOY]     used by Docker/Terraform/deployment tooling.
#   [OPTIONAL]   only needed when that integration/profile is enabled.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE RUNTIME [CORE]
# ----------------------------------------------------------------------------
PROJECT_PIPELINE_PROFILE=local
PROJECT_PIPELINE_ENVIRONMENT=development

PROJECT_PIPELINE_LOG_LEVEL=INFO
PROJECT_PIPELINE_LOG_FORMAT=JSON
PROJECT_PIPELINE__LOGGING__SERVICE_NAME=project-pipeline
PROJECT_PIPELINE__LOGGING__INCLUDE_SOURCE=false
PROJECT_PIPELINE__LOGGING__INCLUDE_PROCESS=true
PROJECT_PIPELINE__LOGGING__INCLUDE_THREAD=false

# Safe default: deny external writes unless an approved profile/action enables them.
# Valid values: DENY | DRY_RUN | REQUIRE_APPROVAL
PROJECT_PIPELINE_EXTERNAL_WRITE_MODE=DENY
PROJECT_PIPELINE__SECURITY__REQUIRE_EXPLICIT_APPROVAL=true

PROJECT_PIPELINE_DATA_DIR=.local/data
PROJECT_PIPELINE_STATE_DIR=.local/state
PROJECT_PIPELINE_EVIDENCE_DIR=evidence
PROJECT_PIPELINE_ARTIFACT_DIR=.local/artifacts
PROJECT_PIPELINE_CACHE_DIR=.local/cache
PROJECT_PIPELINE_LOG_DIR=.local/logs
PROJECT_PIPELINE__PATHS__CREATE_ON_BOOT=true

# ----------------------------------------------------------------------------
# 2. TELEMETRY / OBSERVABILITY [CORE + OPTIONAL TOOL]
# ----------------------------------------------------------------------------
PROJECT_PIPELINE_TELEMETRY_ENABLED=false
PROJECT_PIPELINE__TELEMETRY__EXPORTER=NONE
PROJECT_PIPELINE_OTLP_ENDPOINT=
PROJECT_PIPELINE__TELEMETRY__SERVICE_NAME=project-pipeline
PROJECT_PIPELINE__TELEMETRY__SERVICE_NAMESPACE=project-pipeline

# Optional standard OTLP variables for collectors/instrumentation launched outside
# the core RuntimeSettings loader.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ----------------------------------------------------------------------------
# 3. PERSISTENCE [CORE + SECRET]
# ----------------------------------------------------------------------------
# Default local mode.
PROJECT_PIPELINE_PERSISTENCE_BACKEND=SQLITE_LOCAL
PROJECT_PIPELINE_SQLITE_PATH=.local/state/project_pipeline.db
PROJECT_PIPELINE__PERSISTENCE__MIGRATION_CATALOG=database/MIGRATION_CATALOG.json
PROJECT_PIPELINE__PERSISTENCE__AUTO_MIGRATE=true

# PostgreSQL production/recovery mode. To enable, change the backend above to
# POSTGRESQL and uncomment PROJECT_PIPELINE_POSTGRESQL_DSN_REF.
# PROJECT_PIPELINE_PERSISTENCE_BACKEND=POSTGRESQL
# PROJECT_PIPELINE_POSTGRESQL_DSN_REF=env://PROJECT_PIPELINE_DATABASE_DSN
PROJECT_PIPELINE_DATABASE_DSN=

# Optional libpq/psql/backup-tool compatibility values. The core runtime uses the
# DSN above; these are for external PostgreSQL tools when required.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=project_pipeline
PGUSER=project_pipeline
PGPASSWORD=

# ----------------------------------------------------------------------------
# 4. COMMAND CENTER / LOCAL OPERATOR AUTH [SECRET]
# ----------------------------------------------------------------------------
# Required by scripts/run_command_center_service.py when the authenticated service
# is exposed. Generate a long random token; never use this example file as a value.
PROJECT_PIPELINE_COMMAND_CENTER_TOKEN=

# ----------------------------------------------------------------------------
# 5. ROOT OF TRUST / SOPS / AGE [SECRET + TOOL]
# ----------------------------------------------------------------------------
# Referenced directly by config/root_of_trust.json.
PROJECT_PIPELINE_POLICY_ROOT_KEY=
PROJECT_PIPELINE_AGE_IDENTITY=

# Preferred SOPS/age file-based identity for external SOPS tooling.
SOPS_AGE_KEY_FILE=
# Optional inline SOPS age key; prefer SOPS_AGE_KEY_FILE where possible.
SOPS_AGE_KEY=

# ----------------------------------------------------------------------------
# 6. OPENAI API [OPTIONAL API PROVIDER]
# ----------------------------------------------------------------------------
# This is separate from ChatGPT/Codex subscription authentication.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# ----------------------------------------------------------------------------
# 7. OPENROUTER [OPTIONAL API PROVIDER]
# ----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers if the adapter/launcher maps them.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Project Pipeline

# ----------------------------------------------------------------------------
# 8. CURSOR CLI / AUTOMATION [OPTIONAL]
# ----------------------------------------------------------------------------
# Cursor CLI can use its browser login for interactive use. Headless automation
# may use CURSOR_API_KEY.
CURSOR_API_KEY=

# ----------------------------------------------------------------------------
# 9. GEMINI CLI / CODEX / CHATGPT SUBSCRIPTIONS [NO API SECRET IN .env]
# ----------------------------------------------------------------------------
# GEMINI:
#   Intended mode: Gemini CLI -> Sign in with Google using the subscription account.
#   No GEMINI_API_KEY is intentionally defined here.
#
# CODEX CLI / CODEX DESKTOP:
#   Intended mode: authenticate through the product/account login flow.
#   OPENAI_API_KEY is only needed if you explicitly select the metered API provider.
#
# CHATGPT:
#   Subscription/browser/desktop session auth is managed outside this repository.

# ----------------------------------------------------------------------------
# 10. LOCAL MODEL RUNTIMES / LOCAL GATEWAY [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Matches config/resilience_policy.json defaults.
OLLAMA_HOST=http://127.0.0.1:11434
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
LLAMA_SWAP_BASE_URL=http://127.0.0.1:8081

# Optional LiteLLM gateway profile.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=

# ----------------------------------------------------------------------------
# 11. DURABLE ORCHESTRATION - HATCHET [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Only required when the live Hatchet backend is enabled/qualified.
HATCHET_CLIENT_TOKEN=
# Self-hosted deployments may require a TLS-strategy override; leave blank unless
# your reviewed Hatchet deployment requires it.
HATCHET_CLIENT_TLS_STRATEGY=

# ----------------------------------------------------------------------------
# 12. TAILSCALE MESH NETWORKING [OPTIONAL TOOL / REQUIRED FOR DISTRIBUTED TOPOLOGY]
# ----------------------------------------------------------------------------
# Official Tailscale automation/container variable names.
# Prefer reusable/ephemeral tagged auth keys appropriate to your tailnet policy.
TS_AUTHKEY=
TS_HOSTNAME=
TS_STATE_DIR=
TS_EXTRA_ARGS=

# Examples of intended hostnames (choose per machine, do not enable both here):
# TS_HOSTNAME=project-pipeline-control
# TS_HOSTNAME=project-pipeline-worker-gpu

# ----------------------------------------------------------------------------
# 13. GITHUB [CORE + SECRET]
# ----------------------------------------------------------------------------
# Project Pipeline GitHub Steward secret reference.
GITHUB_TOKEN_REF=env://GITHUB_TOKEN
GITHUB_TOKEN=

# GitHub CLI commonly uses GH_TOKEN. Set it to the same appropriately scoped
# credential when the local `gh` CLI is part of the execution path.
GH_TOKEN=

# Official GitHub MCP profile in src/project_pipeline/upstream_integrations/mcp.py.
GITHUB_MCP_TOKEN=

# ----------------------------------------------------------------------------
# 14. JIRA / ATLASSIAN [CORE + SECRET]
# ----------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN_REF=env://JIRA_API_TOKEN
JIRA_API_TOKEN=

# Official Atlassian MCP profile. This may be a separately scoped token/OAuth
# credential depending on the selected MCP authentication mode.
ATLASSIAN_MCP_TOKEN=

# ----------------------------------------------------------------------------
# 15. AWS CREDENTIAL / PROFILE BOUNDARY [CORE + OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Preferred local mode: AWS SSO/profile/role credentials; avoid long-lived keys.
AWS_PROFILE=project-pipeline
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional headless/temporary credential path. Leave blank when using AWS SSO,
# an instance role, workload identity, or another credential provider.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=

# ----------------------------------------------------------------------------
# 16. AWS / TERRAFORM CLOUD-SPINE INPUTS [DEPLOY]
# ----------------------------------------------------------------------------
# These map to infrastructure/aws/terraform/variables.tf through Terraform's
# standard TF_VAR_* convention. Cloud-spine and circuit breaker remain disabled
# until explicitly authorized and qualified.
TF_VAR_enable_cloud_spine=false
TF_VAR_project_name=project-pipeline
TF_VAR_environment=recovery
TF_VAR_aws_region=us-east-1
TF_VAR_backup_retention_days=30
TF_VAR_monthly_budget_usd=25

TF_VAR_enable_budget_circuit_breaker=false
TF_VAR_budget_action_execution_role_arn=
TF_VAR_budget_guardrail_policy_arn=
TF_VAR_budget_guardrail_target_roles=[]
TF_VAR_budget_action_subscriber_email=

# ----------------------------------------------------------------------------
# 17. DOCKER / COMMAND CENTER CONTAINER [DEPLOY]
# ----------------------------------------------------------------------------
# REQUIRED for the hardened Docker build. Supply an immutable image digest, e.g.
# a reviewed python image pinned as name@sha256:<digest>. Do not use :latest.
PROJECT_PIPELINE_BASE_IMAGE=
COMPOSE_PROJECT_NAME=project-pipeline

# ----------------------------------------------------------------------------
# 18. NOTIFICATION DELIVERY [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Project Pipeline remains the notification authority. These are delivery-adapter
# inputs for a launcher/operator integration; remote delivery stays disabled by
# policy until explicitly enabled and qualified.
#
# Apprise accepts one or more service URLs. Keep credentials out of source control.
APPRISE_URLS=

# Optional self-hosted/mobile ntfy adapter.
NTFY_ENDPOINT=
NTFY_TOPIC=

# ----------------------------------------------------------------------------
# 19. BACKUP / RESTORE TOOLING [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# restic is the general encrypted backup tool selected by resilience policy.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
# Optional inline password. Prefer RESTIC_PASSWORD_FILE.
RESTIC_PASSWORD=
RESTIC_CACHE_DIR=.local/cache/restic

# pgBackRest is the selected PostgreSQL-specific backup tool. Project Pipeline's
# planner currently uses stanza `project-pipeline`; pgBackRest connection/repository
# settings belong in the reviewed pgBackRest configuration file rather than being
# invented as unsupported project-specific environment variables here.

# ----------------------------------------------------------------------------
# 20. INFRACOST / PRE-DEPLOYMENT AWS COST EVIDENCE [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Local interactive use can authenticate with `infracost auth login`. Use these
# only for non-interactive/headless runs when Infracost is enabled.
INFRACOST_CLI_AUTHENTICATION_TOKEN=
INFRACOST_CLI_ORG=

# ----------------------------------------------------------------------------
# 21. OPTIONAL PROXY / STANDARD NETWORK VARIABLES [OPTIONAL TOOL]
# ----------------------------------------------------------------------------
# Leave unset unless your environment requires an explicit proxy. Never place
# credentials in proxy URLs committed to source control.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# ============================================================================
# END OF EXAMPLE
# ============================================================================
# Before using live integrations:
# 1. Populate only the credentials/endpoints required for the enabled profile.
# 2. Keep PROJECT_PIPELINE_EXTERNAL_WRITE_MODE=DENY until write authority is ready.
# 3. Validate configuration before starting workers/services.
# 4. Authenticate Gemini CLI/Codex/ChatGPT subscriptions through their own login
#    flows; do not convert subscription-backed workers into unnecessary API billing.
# 5. Never commit the populated .env file.
