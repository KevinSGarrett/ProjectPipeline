{
  "candidate_may_read": [
    "BENCHMARK_BRIEF.md",
    "INPUT_MANIFEST.json",
    "intake/",
    "requirements_source/",
    "source_registry/",
    "seed_repository/",
    "seed_repositories/",
    "fixtures/",
    "visible_tests/",
    "mock_services/",
    "constraints/",
    "environment/",
    "jira/seed/",
    "github/seed/",
    "fault_overlays/catalog.json",
    "third_party/"
  ],
  "candidate_may_write": [
    "workspace/",
    "candidate_outputs/",
    "run_logs/"
  ],
  "candidate_must_not_read": [
    "../Oracle_Pack",
    "../../common/private",
    "*gold*",
    "*hidden_tests*",
    "*reference_solution*"
  ],
  "candidate_must_not_write": [
    "Project_Pack/",
    "Oracle_Pack/",
    "common/",
    "outside_declared_target_root"
  ],
  "hard_gate_on_violation": "ORACLE_ACCESS_ATTEMPT_OR_UNAUTHORIZED_EXTERNAL_MUTATION",
  "schema_version": "1.0.0"
}
