{
  "branch_naming": "<project-key>/<issue-id>-<slug>",
  "default_branch_direct_commit": "PROHIBITED",
  "external_writes": "DENIED_BY_DEFAULT",
  "one_pull_request_per_authorized_change": true,
  "required_evidence_before_merge": [
    "tests",
    "review",
    "security",
    "traceability",
    "clean_worktree"
  ],
  "schema_version": "1.0.0",
  "unknown_outcome_rule": "VERIFY_READ_ONLY_BEFORE_RETRY"
}
