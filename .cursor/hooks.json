{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/guard_shell.py",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/continue-cycle.py",
        "timeout": 30
      }
    ]
  }
}
