{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor\\hooks\\invoke_python.cmd .cursor\\hooks\\guard_shell.py",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": ".cursor\\hooks\\invoke_python.cmd .cursor\\hooks\\continue-cycle.py",
        "timeout": 30
      }
    ]
  }
}
