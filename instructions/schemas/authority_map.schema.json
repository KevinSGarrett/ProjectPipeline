      "minItems": 4,
      "type": "array"
    },
    "derived_and_advisory": {
      "minItems": 3,
      "type": "array"
    },
    "normative_order": {
      "minItems": 5,
      "type": "array"
    },
    "observational_order": {
      "minItems": 3,
      "type": "array"
    },
    "project_id": {
      "type": "string"
    },
