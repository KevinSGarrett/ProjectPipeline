{
  "global_rules": [
    "required checks run against current head SHA",
    "AI review supplements deterministic checks",
    "failed required checks block integration",
    "local reproduction commands are documented"
  ],
  "project_id": "PROJECT-PIPELINE",
  "schema_version": "1.0.0",
  "tiers": [
    {
      "change_class": "code_default",
      "checks": [
        "instruction validation",
        "repository contract validation",
        "schema and dependency validation",
        "lint and format",
        "static typing where in scope",
        "targeted and related tests",
        "coverage regression check",
        "distribution build when packaging is affected"
      ],
      "tier": "A"
    },
    {
      "change_class": "dependency_or_supply_chain",
      "checks": [
        "dependency review",
        "vulnerability audit",
        "license and provenance review",
        "lock consistency",
        "supply-chain policy validation"
      ],
      "inherits": [
        "A"
      ],
      "tier": "B"
    },
    {
      "change_class": "security_or_control_plane",
      "checks": [
        "CodeQL",
        "security tests",
        "adversarial or fault tests where applicable",
        "authority-policy validation",
        "independent review",
        "rollback material"
      ],
      "inherits": [
        "A"
      ],
      "tier": "C"
    },
    {
      "change_class": "ui",
      "checks": [
        "browser test",
        "accessibility test",
        "visual evidence when behavior is visual"
      ],
      "inherits": [
        "A"
      ],
      "tier": "D"
    },
    {
      "change_class": "release_post_merge_or_scheduled",
      "checks": [
        "broad end-to-end verification",
        "applicable PPQS suite",
        "performance or fault checks when risk requires",
        "artifact build",
        "SBOM",
        "integrity hashes",
        "provenance or attestation",
        "installation test",
        "recovery verification"
      ],
      "inherits": [
        "A",
        "B",
        "C"
      ],
      "tier": "E"
    },
    {
      "change_class": "instructions_or_policy",
      "checks": [
        "instruction validator",
        "cold-start test",
        "scenario suite A through L",
        "secret scan",
        "authority and coverage consistency",
        "independent review under security policy"
      ],
      "inherits": [
        "A",
        "C"
      ],
      "tier": "I"
    },
    {
      "change_class": "low_risk_docs_only",
      "checks": [
        "instruction validation when governed files are touched",
        "markdown links",
        "secret scan",
        "targeted repository contract checks"
      ],
      "excludes_by_default": [
        "broad benchmark suite",
        "performance suite",
        "full UI suite"
      ],
      "tier": "F"
    }
  ]
}
