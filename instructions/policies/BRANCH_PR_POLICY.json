{
  "branch_patterns": [
    "^(feat|fix|refactor|test|docs|chore)/PP-(TASK|STORY|BUG)-[0-9]{6}-[a-z0-9][a-z0-9-]*$",
    "^hotfix/PP-BUG-[0-9]{6}-[a-z0-9][a-z0-9-]*$",
    "^release/v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$"
  ],
  "cleanup_preconditions": [
    "merged or intentionally closed",
    "no owning worktree",
    "no uncommitted or unpublished work",
    "post-merge verification complete"
  ],
  "cleanup_authority": {
    "human_confirmation_required": false,
    "mode": "AUTONOMOUS_WHEN_PRECONDITIONS_PASS",
    "remote_readback_required": true
  },
  "default_branch": "main",
  "dirty_worktree_policy": "PRESERVE_INSPECT_RECONCILE",
  "epics_are_directly_executable": false,
  "multi_item_pr_allowed_when": [
    "same functional slice",
    "shared acceptance boundary",
    "must integrate together",
    "single rollback unit",
    "coherent review"
  ],
  "delivery_progress_gate": {
    "already_implemented_work": "RECONCILIATION_REQUIRED_NOT_IMPLEMENTATION_READY",
    "expensive_gate_boundary": "COHESIVE_VERTICAL_SLICE",
    "lifecycle_transition_is_deliverable": false,
    "lifecycle_only_pr_allowed": false,
    "minimum_evidence_backed_reconciliation_batch_items": 3,
    "single_task_lifecycle_pr_exception": "NONE"
  },
  "permanent_development_branch": false,
  "pr_split_required_when": [
    "unrelated architectural domains",
    "independent rollback units",
    "materially different risk or reviewer boundary"
  ],
  "pr_unit": "coherent_mergeable_engineering_change",
  "review_authority": {
    "github_human_approval_required": false,
    "independent_receipt_required_by_risk": true,
    "independent_verifier_may_be_automated": true
  },
  "project_id": "PROJECT-PIPELINE",
  "schema_version": "1.0.0",
  "wip": {
    "default_active_implementation_lanes": 2,
    "effective_cap_rule": "minimum of scheduler-safe lanes, available isolated workers, resource-conflict capacity, and merge-throughput capacity",
    "maximum_without_explicit_capacity_evidence": 3
  },
  "worktree_requirements": [
    "owning work item",
    "branch",
    "worktree path",
    "base SHA",
    "resource claims",
    "merge target"
  ]
}
